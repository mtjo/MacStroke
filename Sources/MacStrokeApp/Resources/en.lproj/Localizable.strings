/* Hold the trigger button + scroll (issue #75, port extension; configured on the right-click page) */
"Wheel Gesture" = "Hold the trigger button + scroll";
"Wheel Gesture master" = "Enable scroll triggers";
"Wheel Gesture master hint" = "The master switch. With it off the scroll listener is never armed, so every wheel tick goes back to the front app untouched — that is the original behaviour. The trigger button is the one recorded on the General page (right button by default).";
"Wheel Gesture up row" = "Scroll up";
"Wheel Gesture up hint" = "One notch is one trigger: a high-resolution wheel or a trackpad's inertia is folded into a single action, and that notch is swallowed so the page does not move. A direction set to “None” never swallows anything.";
"Wheel Gesture down row" = "Scroll down";
"Wheel Gesture up shortcut" = "Scroll-up shortcut";
"Wheel Gesture down shortcut" = "Scroll-down shortcut";
"Wheel Gesture shortcut hint" = "Only used when that direction is set to “Custom shortcut”. An empty recorder means that direction does nothing at all.";
